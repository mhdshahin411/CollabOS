# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never exposed to the client

# OpenAI — https://platform.openai.com/api-keys (deal extraction + voice briefings)
OPENAI_API_KEY=your-openai-api-key

# Shared secret between the app and n8n: n8n sends it as `x-webhook-secret` on
# /api/ingest, and the app sends it on calls to the outbound reply webhook.
N8N_WEBHOOK_SECRET=generate-a-long-random-string

# n8n "Outbound Reply" webhook that sends Gmail replies. If unset, replies are
# saved on the thread as notes but not sent.
N8N_OUTBOUND_WEBHOOK_URL=https://your-n8n-host/webhook/collabos-reply

# Optional: the n8n workflow where Gmail is (re)connected, linked from Settings.
NEXT_PUBLIC_N8N_GMAIL_WORKFLOW_URL=
